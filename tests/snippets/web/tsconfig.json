{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "exactOptionalPropertyTypes": true, "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true, "noEmit": true, "skipLibCheck": true,
    "types": ["vitest/globals", "vite/client", "node"], "paths": { "@/*": ["./generated/*"] }, "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["generated", "tests", "vitest.config.ts"]
}
